# Environment Configuration Example
# Copy this file to .env and fill in your values

# Frontend URL (for UI tests)
BASE_URL=http://168.119.175.142:4173

# API URL (for API calls - usually same as BASE_URL but with port 8001)
API_URL=http://168.119.175.142:8001

# Authentication credentials
BEFFA_USER=your-email@example.com
BEFFA_PASS=your-password
BEFFA_TOKEN=your-token

# Company configuration
BEFFA_COMPANY=BM Tech

# Fiscal year configuration
BEFFA_YEAR=2018
BEFFA_PERIOD=yearly
BEFFA_CALENDAR=ec

# Debug mode (set to 'true' to enable verbose console logging)
DEBUG=false
